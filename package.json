{
  "name": "kost-traningsdagbok",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run && node --test server/shared.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "python3 e2e/smoke.py e2e-shots",
    "check": "npm run lint && npm run typecheck && npm test && vite build",
    "ai-server": "node server/node-server.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}